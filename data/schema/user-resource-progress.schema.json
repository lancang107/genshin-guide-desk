{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "user-resource-progress.schema.json",
  "title": "User Resource Progress",
  "description": "Per-user state kept separately from the public resource catalog.",
  "type": "object",
  "required": ["resourceId", "state", "updatedAt"],
  "properties": {
    "resourceId": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "state": { "type": "string", "enum": ["not-started", "in-progress", "completed", "skipped", "unknown"] },
    "completedAt": { "type": "string", "format": "date-time" },
    "progress": { "type": "number", "minimum": 0, "maximum": 1 },
    "notes": { "type": "string", "maxLength": 500 },
    "updatedAt": { "type": "string", "format": "date-time" }
  }
}
